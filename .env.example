# Copied to .env by `make env`. Dev-only values; real secrets never go in git.
# --- infrastructure (published on localhost for inspection tools)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
SERVICE_DATABASES=template_go template_py template_java
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025
# --- observability (profile obs)
JAEGER_UI_PORT=16686
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# Set OTEL_IN_DOCKER=http://otel-collector:4318 to export traces from containers when the obs profile runs
OTEL_IN_DOCKER=
