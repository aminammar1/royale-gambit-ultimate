{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://royal-gambit.dev/contracts/events/profile.updated.schema.json",
  "title": "profile.updated",
  "description": "`data` of the event auth-profile publishes when a player's username or country changes. Settings stay out (and changing only them publishes nothing): they only matter to the player's own devices.",
  "type": "object",
  "additionalProperties": false,
  "required": ["user_id", "username", "country", "updated_at"],
  "properties": {
    "user_id": { "type": "string", "format": "uuid" },
    "username": { "type": "string", "pattern": "^[A-Za-z0-9_-]{3,20}$" },
    "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
